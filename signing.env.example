# Credenciais de assinatura e notarizacao do Edvid (macOS).
# Copie para "signing.env" (que e ignorado pelo git) e preencha.
# NUNCA commitar o signing.env preenchido; segredos nao entram no repositorio.

# Nome exato da identidade no Keychain, apos instalar o certificado
# Developer ID Application. Descubra com:
#   security find-identity -v -p codesigning
EDVID_MAC_SIGN_IDENTITY="Developer ID Application: NOME (TEAMID)"

# Apple ID (e-mail) da conta Apple Developer.
EDVID_APPLE_ID=""

# Senha de app gerada em https://account.apple.com (Senhas de app).
# Formato: xxxx-xxxx-xxxx-xxxx
EDVID_APPLE_APP_PASSWORD=""

# Team ID da conta (10 caracteres; aparece no nome do certificado e em
# https://developer.apple.com/account -> Membership details).
EDVID_APPLE_TEAM_ID=""

# --- OTA: bucket Cloudflare R2 ---------------------------------------------
# Account ID do Cloudflare (dashboard -> R2 -> canto direito).
EDVID_CF_ACCOUNT_ID=""
# API token com permissao "R2 - Edit" (dashboard -> R2 -> Manage API Tokens).
EDVID_CF_API_TOKEN=""
# Nome do bucket (ex.: edvid-updates).
EDVID_R2_BUCKET=""
# URL publica do bucket (r2.dev habilitado no bucket, ou dominio proprio).
EDVID_UPDATE_BASE_URL=""
